# Vigilance Configuration
# Copy to .env and adjust values

# Database
# SQLite (default): sqlite+aiosqlite:////app/data/vigilance.db
# PostgreSQL: postgresql+asyncpg://user:password@host:5432/dbname
VIGILANCE_DATABASE_URL=postgresql+asyncpg://vigilance:vigilance@postgres:5432/vigilance

# Proxmox (can also be in config.yaml)
VIGILANCE_PROXMOX_URL=https://proxmox.example.com:8006
VIGILANCE_PROXMOX_TOKEN_ID=vigilance@pam
VIGILANCE_PROXMOX_TOKEN_SECRET=your-token-secret
VIGILANCE_PROXMOX_VERIFY_TLS=true

# Gotify
VIGILANCE_GOTIFY_URL=https://gotify.example.com
VIGILANCE_GOTIFY_TOKEN=your-app-token
VIGILANCE_GOTIFY_MIN_SEVERITY=HIGH
VIGILANCE_GOTIFY_DIGEST_MODE=false

# Auth
VIGILANCE_AUTH_MODE=proxy
# Write access: generate a token with `vigilance token-rotate` (stored hashed in the DB).
# This value is only used as long as no token was generated.
VIGILANCE_API_TOKEN=
# Reverse proxies whose Remote-User header is trusted (IPs/CIDRs, comma separated), e.g. Zoraxy:
# VIGILANCE_TRUSTED_PROXIES=192.0.2.101
VIGILANCE_TRUSTED_PROXIES=
VIGILANCE_REMOTE_USER_HEADER=Remote-User

# CVE Sync
VIGILANCE_CVE_SYNC_INTERVAL_HOURS=6
VIGILANCE_NVD_API_KEY=
# GitHub token for GHSA sync (optional, increases rate limit from 60/hour to 5000/hour)
VIGILANCE_GITHUB_TOKEN=

# Scan
VIGILANCE_SCAN_INTERVAL_HOURS=24
VIGILANCE_SSH_TIMEOUT=30
VIGILANCE_SSH_PARALLEL_JOBS=10

# App
VIGILANCE_LOG_LEVEL=INFO
VIGILANCE_SECRET_KEY=change-me-in-production